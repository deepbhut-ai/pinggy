# ---- App ----
APP_NAME=pinggy
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pinggy
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/pinggy

# ---- JWT ----
JWT_SECRET=prod-pinggy-secret-7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- SSH Tunnel Server ----
SSH_HOST=0.0.0.0
SSH_PORT=2222
TUNNEL_DOMAIN=iraglobaltech.com
TUNNEL_PORT_MIN=10000
TUNNEL_PORT_MAX=20000
PROXY_PORT=8000
SUBDOMAIN_LENGTH=7

# ---- Redis (IP monitoring + cache) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
IP_RATE_WINDOW=60
IP_RATE_BLOCK_THRESHOLD=500
IP_BLOCK_DURATION=3600
IP_GEO_ENABLED=true
IP_GEO_API_URL=http://ip-api.com/json/

STRIPE_SECRET_KEY="" # add your sk_live_... key on the server .env only; do not commit real secrets
STRIPE_WEBHOOK_SECRET="" # whsec_... from Stripe dashboard
STRIPE_ENABLED="true" # false to disable
PAYPAL_MODE="live"
PAYPAL_CLIENT_ID="" # add your PayPal client ID on the server .env only
PAYPAL_CLIENT_SECRET="" # add your PayPal secret on the server .env only
PAYPAL_WEBHOOK_SECRET="" # webhook ID or secret from PayPal dashboard
PAYPAL_ENABLED="true" # false to disable
NOWPAYMENTS_API_KEY="" # add your NowPayments API key on the server .env only
NOWPAYMENTS_IPN_SECRET="" # add your NowPayments IPN secret on the server .env only
NOWPAYMENTS_ENABLED="true" # false to disable
NOWPAY_BASE_URL="https://api.nowpayments.io/"
NOWPAY_PRICE_CURRENCY="USD"