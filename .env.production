# ---- App ----
APP_NAME=pinggy
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pinggy
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/pinggy

# ---- JWT ----
JWT_SECRET=prod-pinggy-secret-7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- SSH Tunnel Server ----
SSH_HOST=0.0.0.0
SSH_PORT=2222
TUNNEL_DOMAIN=iraglobaltech.com
TUNNEL_PORT_MIN=10000
TUNNEL_PORT_MAX=20000
PROXY_PORT=8000
SUBDOMAIN_LENGTH=7

# ---- Redis (IP monitoring + cache) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
IP_RATE_WINDOW=60
IP_RATE_BLOCK_THRESHOLD=500
IP_BLOCK_DURATION=3600
IP_GEO_ENABLED=true
IP_GEO_API_URL=http://ip-api.com/json/

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_ENABLED=true
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox
PAYPAL_ENABLED=true
NOWPAYMENTS_API_KEY=xxx
NOWPAYMENTS_IPN_SECRET=xxx
NOWPAYMENTS_ENABLED=true