# ---- App ----
APP_NAME=pinggy
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
# psycopg3 async DSN: postgresql+psycopg://user:pass@host:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pinggy
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/pinggy

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- SSH Tunnel Server ----
SSH_HOST=0.0.0.0
SSH_PORT=2222
TUNNEL_DOMAIN=localhost
TUNNEL_PORT_MIN=10000
TUNNEL_PORT_MAX=20000
PROXY_PORT=8080
SUBDOMAIN_LENGTH=7

# ---- Redis (IP monitoring + cache) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
IP_RATE_WINDOW=60
IP_RATE_BLOCK_THRESHOLD=500
IP_BLOCK_DURATION=3600
IP_GEO_ENABLED=true
IP_GEO_API_URL=http://ip-api.com/json/

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox
NOWPAYMENTS_API_KEY=xxx
NOWPAYMENTS_IPN_SECRET=xxx