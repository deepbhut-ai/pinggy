# ---- App ----
APP_NAME=pinggy
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
# psycopg3 async DSN: postgresql+psycopg://user:pass@host:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pinggy
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/pinggy

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- SSH Tunnel Server ----
SSH_HOST=0.0.0.0
SSH_PORT=2222
TUNNEL_DOMAIN=localhost
TUNNEL_PORT_MIN=10000
TUNNEL_PORT_MAX=20000
PROXY_PORT=8080
SUBDOMAIN_LENGTH=7

# ---- Redis (IP monitoring + cache) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
IP_RATE_WINDOW=60
IP_RATE_BLOCK_THRESHOLD=500
IP_BLOCK_DURATION=3600
IP_GEO_ENABLED=true
IP_GEO_API_URL=http://ip-api.com/json/

# ---- Payments (optional) ----
NOWPAYMENTS_IPN_SECRET=""
NOWPAY_PRICE_CURRENCY="USD"
NOWPAY_API_KEY=""
NOWPAYMENTS_API_KEY=""
NOWPAY_BASE_URL="https://api.nowpayments.io/"
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PAYMENT="NO"
STRIPE_KEY=""
STRIPE_SECRET=""
STRIPE_PAYMENT="NO"

# ---- SSL & Custom Domains ----
SERVER_IP=13.140.131.204
SSL_WEBROOT_PATH=/var/www/certbot
SSL_CERT_DIR=/etc/letsencrypt/live
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
SSL_ADMIN_EMAIL=support@callingagents.in
SSL_ENABLED=true