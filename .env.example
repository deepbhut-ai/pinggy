# ---- App ----
APP_NAME=pinggy
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
# psycopg3 async DSN: postgresql+psycopg://user:pass@host:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pinggy
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/pinggy

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60