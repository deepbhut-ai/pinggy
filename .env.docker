# pinggy Docker Environment File
# Copy this to .env and edit values
#   cp .env.docker .env && nano .env
# Then: docker compose up -d

# ---- Domain ----
DOMAIN=iraglobaltech.com

# ---- Database ----
DB_USER=pinggy
DB_PASS=pinggy_secret
DB_NAME=pinggy

# ---- JWT (change to a random string) ----
JWT_SECRET=change-me-to-a-random-string

# ---- SSH Port (must be exposed directly, not through nginx) ----
SSH_PORT=2222

# ---- Payments (leave empty to disable) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_ENABLED=false